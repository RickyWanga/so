---
import Base from '../layouts/Base.astro';
import { g2Areas, g2Questions } from '../data/g2.js';
---
<Base title="Domande G2" active="/g2/">
  <p class="sovratitolo">Tappa IV · Teoria</p>
  <h1>Una domanda, una risposta, due minuti.</h1>
  <p class="sottotitolo">Le domande che ritornano negli appelli. Quelle uscite nel 2026 sono marcate come calde.</p>

  <div class="filtri">
    <label class="largo">Cerca
      <input type="text" id="q" placeholder="es. salt, knot, RAID, TLB..." />
    </label>
    <label>Area
      <select id="area">
        {g2Areas.map((a) => <option value={a}>{a}</option>)}
      </select>
    </label>
    <label class="riga"><input type="checkbox" id="hot" /> Solo calde 2026</label>
  </div>
  <p class="conteggio"><strong id="count"></strong> domande · <span id="total"></span> <span id="notice" hidden></span></p>

  <div id="list"></div>
  <p class="vuoto" id="empty" hidden>Niente con questi filtri: allarga la ricerca.</p>
</Base>

<script id="g2-data" type="application/json" set:html={JSON.stringify(g2Questions)} />

<script is:inline>
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const data = JSON.parse(document.getElementById('g2-data').textContent);
  const $ = (id) => document.getElementById(id);
  const params = new URLSearchParams(location.search);
  if (params.get('area')) $('area').value = params.get('area');
  const fromLink = params.get('area');
  const notice = $('notice');
  function paintNotice() {
    if (!fromLink) return;
    notice.hidden = false;
    notice.innerHTML = ' · Filtro da link: ' + esc($('area').value) +
      ' <a href="/g2/" style="margin-left:0.4rem;">Azzera</a>';
  }

  function render() {
    const needle = $('q').value.trim().toLowerCase();
    const list = $('list');
    list.innerHTML = '';
    let n = 0;
    for (const item of data) {
      if ($('area').value !== 'Tutte' && item.area !== $('area').value) continue;
      if ($('hot').checked && !item.hot) continue;
      if (needle && ![item.question, item.area, item.answer, item.source].join(' ').toLowerCase().includes(needle)) continue;
      n++;
      const el = document.createElement('details');
      el.className = 'scheda';
      el.innerHTML =
        '<summary><div class="etichette"><span class="etichetta">' + esc(item.area) + '</span>' +
        (item.hot ? '<span class="etichetta calda">Calda</span>' : '') + '</div>' +
        '<h3>' + esc(item.question) + '</h3>' +
        '<span class="apri">Risposta</span></summary>' +
        '<div class="corpo">' +
        '<p class="fonte">Uscita: ' + esc(item.source) + '</p>' +
        '<div class="marginale"><span class="rubrica">Risposta</span><p>' + esc(item.answer) + '</p></div></div>';
      list.appendChild(el);
    }
    $('count').textContent = n;
    $('total').textContent = data.length + ' totali';
    $('empty').hidden = n > 0;
    paintNotice();
  }
  ['q', 'area', 'hot'].forEach((id) => $(id).addEventListener('input', render));
  render();
</script>
