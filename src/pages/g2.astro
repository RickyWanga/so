---
import Base from '../layouts/Base.astro';
import { g2Areas, g2Questions } from '../data/g2.js';
---
<Base title="Domande G2" active="/g2/">
  <span class="eyebrow">Domande teoriche</span>
  <h1>G2: domanda e risposta in due minuti</h1>
  <p class="lead">Le domande che ritornano negli appelli, con la risposta da scrivere allo scritto. Quelle calde nel 2026 sono marcate Hot.</p>

  <div class="filters">
    <label class="grow">Cerca
      <input type="text" id="q" placeholder="es. salt, knot, RAID, TLB..." />
    </label>
    <label>Area
      <select id="area">
        {g2Areas.map((a) => <option value={a}>{a}</option>)}
      </select>
    </label>
    <label class="checkline"><input type="checkbox" id="hot" /> Solo Hot 2026</label>
  </div>
  <p class="result-line"><strong id="count"></strong> domande trovate <span id="total"></span></p>

  <div class="grid" id="list" style="grid-template-columns: 1fr;"></div>
  <p class="empty" id="empty" hidden>Nessuna domanda con questi filtri.</p>
</Base>

<script id="g2-data" type="application/json" set:html={JSON.stringify(g2Questions)} />

<script is:inline>
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const data = JSON.parse(document.getElementById('g2-data').textContent);
  const $ = (id) => document.getElementById(id);
  const params = new URLSearchParams(location.search);
  if (params.get('area')) $('area').value = params.get('area');

  function render() {
    const needle = $('q').value.trim().toLowerCase();
    const list = $('list');
    list.innerHTML = '';
    let n = 0;
    for (const item of data) {
      if ($('area').value !== 'Tutte' && item.area !== $('area').value) continue;
      if ($('hot').checked && !item.hot) continue;
      if (needle && ![item.question, item.area, item.answer, item.source].join(' ').toLowerCase().includes(needle)) continue;
      n++;
      const el = document.createElement('details');
      el.className = 'card';
      el.innerHTML =
        '<summary><div class="badges"><span class="badge">' + esc(item.area) + '</span>' +
        (item.hot ? '<span class="badge hot">Hot</span>' : '') + '</div>' +
        '<h3>' + esc(item.question) + '</h3>' +
        '<span class="open-hint">Risposta</span></summary>' +
        '<div class="card-body">' +
        '<p class="source-line">Uscita: ' + esc(item.source) + '</p>' +
        '<p><span class="answer-label">Risposta</span><br>' + esc(item.answer) + '</p></div>';
      list.appendChild(el);
    }
    $('count').textContent = n;
    $('total').textContent = data.length + ' totali';
    $('empty').hidden = n > 0;
  }
  ['q', 'area', 'hot'].forEach((id) => $(id).addEventListener('input', render));
  render();
</script>
