---
import Base from '../layouts/Base.astro';
import { exercises, parts, topics } from '../data/exercises.js';
---
<Base title="Esercizi svolti" active="/esercizi/">
  <p class="sovratitolo">Tappa I–III · Pratica</p>
  <h1>Esercizi svolti, uno per pagina di quaderno.</h1>
  <p class="sottotitolo">Apri una scheda: testo, idea guida, svolgimento, controlli ed errori tipici.</p>

  <div class="filtri">
    <label class="largo">Cerca
      <input type="text" id="q" placeholder="es. testimone, FIFO, Gantt..." />
    </label>
    <label>Parte
      <select id="part">
        {parts.map((p) => <option value={p}>{p}</option>)}
      </select>
    </label>
    <label>Argomento
      <select id="topic">
        {topics.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
    <label class="riga"><input type="checkbox" id="focus" /> Solo focus</label>
  </div>
  <p class="conteggio"><strong id="count"></strong> esercizi · <span id="total"></span></p>

  <div id="list"></div>
  <p class="vuoto" id="empty" hidden>Niente con questi filtri: allarga la ricerca.</p>
</Base>

<script id="ex-data" type="application/json" set:html={JSON.stringify(exercises)} />

<script is:inline>
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const data = JSON.parse(document.getElementById('ex-data').textContent);
  const $ = (id) => document.getElementById(id);
  const params = new URLSearchParams(location.search);
  if (params.get('part')) $('part').value = params.get('part');
  if (params.get('topic')) $('topic').value = params.get('topic');

  function render() {
    const needle = $('q').value.trim().toLowerCase();
    const list = $('list');
    list.innerHTML = '';
    let n = 0;
    for (const e of data) {
      if ($('part').value !== 'Tutte' && e.part !== $('part').value) continue;
      if ($('topic').value !== 'Tutti' && e.topic !== $('topic').value) continue;
      if ($('focus').checked && !e.focus) continue;
      if (needle && ![e.title, e.topic, e.statement, e.idea, e.source].join(' ').toLowerCase().includes(needle)) continue;
      n++;
      const el = document.createElement('details');
      el.className = 'scheda';
      el.innerHTML =
        '<summary><div class="etichette"><span class="etichetta parte">' + esc(e.part) + '</span>' +
        '<span class="etichetta">' + esc(e.topic) + '</span>' +
        (e.focus ? '<span class="etichetta calda">Focus</span>' : '') +
        (e.reconstructed ? '<span class="etichetta">Ricostruito</span>' : '') + '</div>' +
        '<h3>' + esc(e.title) + '</h3>' +
        '<p class="testo-domanda">' + esc(e.statement) + '</p>' +
        '<span class="apri">Svolgimento</span></summary>' +
        '<div class="corpo">' +
        '<p class="fonte">Fonte: ' + esc(e.source) +
        (e.sourceUrl ? ' — <a href="' + esc(e.sourceUrl) + '" target="_blank" rel="noreferrer">PDF ufficiale ↗</a>' : '') + '</p>' +
        '<div class="marginale"><span class="rubrica">Idea guida</span><p>' + esc(e.idea) + '</p></div>' +
        '<pre><code>' + esc(e.solution) + '</code></pre>' +
        '<div class="colonne"><div><h3>Controlli</h3><ul class="tight">' +
        (e.invariants || []).map((x) => '<li>' + esc(x) + '</li>').join('') +
        '</ul></div><div><h3>Errori tipici</h3><ul class="tight">' +
        (e.pitfalls || []).map((x) => '<li>' + esc(x) + '</li>').join('') +
        '</ul></div></div></div>';
      list.appendChild(el);
    }
    $('count').textContent = n;
    $('total').textContent = data.length + ' totali';
    $('empty').hidden = n > 0;
  }
  ['q', 'part', 'topic', 'focus'].forEach((id) =>
    $(id).addEventListener('input', render),
  );
  render();
</script>
