---
import Base from '../layouts/Base.astro';
import { recentOfficialExams, summerPairs } from '../data/prediction.js';

const officialArchiveUrl = 'https://www.cs.unibo.it/~renzo/so/compiti-so.shtml';
---
<Base title="Archivio compiti" active="/archivio/">
  <p class="sovratitolo">Fonti</p>
  <h1>Da dove vengono gli esercizi.</h1>
  <p class="sottotitolo">
    Testi ufficiali quando ci sono, ricostruzioni marcate quando mancano.
    <a class="pulsante primo" href={officialArchiveUrl} target="_blank" rel="noreferrer" style="margin-left:0.5rem;">Archivio ufficiale</a>
  </p>

  <h2>Ultimi compiti pubblicati · 2025-2026</h2>
  {recentOfficialExams.map((exam) => (
    <details class="scheda">
      <summary>
        <div class="etichette"><span class="etichetta">{exam.date}</span></div>
        <h3>{exam.c1}</h3>
        <p class="testo-domanda">C2: {exam.c2} · G1: {exam.g1}</p>
        <span class="apri">PDF ufficiale</span>
      </summary>
      <div class="corpo">
        <p><a href={exam.url} target="_blank" rel="noreferrer">Apri il PDF ↗</a></p>
      </div>
    </details>
  ))}

  <h2>Serie estiva · giugno e luglio 2017-2025</h2>
  <div class="tabella-scorre">
    <table class="dati">
      <thead><tr><th>Anno</th><th>Giu C1</th><th>Giu C2</th><th>Giu G1</th><th>Lug C1</th><th>Lug C2</th><th>Lug G1</th></tr></thead>
      <tbody>
        {summerPairs.map((pair) => (
          <tr>
            <td><strong>{pair.year}</strong></td>
            <td><a href={pair.june.url} target="_blank" rel="noreferrer">{pair.june.c1}</a></td>
            <td>{pair.june.c2}</td>
            <td>{pair.june.g1}</td>
            <td><a href={pair.july.url} target="_blank" rel="noreferrer">{pair.july.c1}</a></td>
            <td>{pair.july.c2}</td>
            <td>{pair.july.g1}</td>
          </tr>
        ))}
        <tr>
          <td><strong>2026</strong> <span class="etichetta">segnalato</span></td>
          <td colspan="6">Contenuti ricostruiti, in attesa del PDF ufficiale.</td>
        </tr>
      </tbody>
    </table>
  </div>
</Base>
