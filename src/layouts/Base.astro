---
import '../styles/global.css';

const { title, active } = Astro.props;

const nav = [
  ['/', 'Home'],
  ['/esercizi/', 'Esercizi'],
  ['/g2/', 'Domande G2'],
  ['/pratica/', 'Pratica'],
  ['/template/', 'Metodo'],
  ['/statistiche/', 'Numeri'],
  ['/simulatore/', 'Simulatore'],
  ['/archivio/', 'Archivio'],
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ripasso per lo scritto di Sistemi Operativi di Renzo Davoli: C1, C2, G1 e domande G2."
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Sistemi Operativi</title>
    <script is:inline>
      try {
        var t = localStorage.getItem('so-theme');
        if (!t && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="titolo" href="/">Sistemi <em>Operativi</em></a>
        <nav>
          {nav.map(([href, label]) => (
            <a href={href} class={active === href ? 'attiva' : ''}>{label}</a>
          ))}
        </nav>
        <button id="tema-btn" class="pulsante" type="button" aria-label="Cambia tema">☾</button>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="piede">
      <div class="wrap">
        <strong>Sistemi Operativi</strong>
        <p>
          Appunti non ufficiali di studenti, per studenti. Verifica sempre sul testo completo.
          Fonte primaria: <a href="https://www.cs.unibo.it/~renzo/so/compiti-so.shtml">archivio ufficiale</a>.
          Di Ricky Wanga · <a href="https://x.com/rickywanga42" target="_blank" rel="noreferrer">X @rickywanga42</a> ·
          <a href="https://rickywanga.com" target="_blank" rel="noreferrer">rickywanga.com</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('tema-btn');
        function paint() {
          var dark = document.documentElement.dataset.theme === 'dark';
          if (btn) btn.textContent = dark ? '☀' : '☾';
        }
        if (btn) btn.addEventListener('click', function () {
          var dark = document.documentElement.dataset.theme !== 'dark';
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          try { localStorage.setItem('so-theme', dark ? 'dark' : 'light'); } catch (e) {}
          paint();
        });
        paint();
      })();
    </script>
  </body>
</html>
