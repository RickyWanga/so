---
import '../styles/global.css';

const { title, active } = Astro.props;

const nav = [
  ['/', 'Home'],
  ['/esercizi/', 'Esercizi'],
  ['/g2/', 'G2'],
  ['/template/', 'Template'],
  ['/statistiche/', 'Statistiche'],
  ['/simulatore/', 'Simulatore'],
  ['/archivio/', 'Archivio'],
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Ripasso mirato per lo scritto di Sistemi Operativi di Renzo Davoli: C1, C2, G1 e domande G2."
    />
    <meta name="theme-color" content="#0a0f1c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — SO Davoli Ripasso</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-mark">SO</span>
          <span><strong>Davoli Ripasso</strong><small>C1 / C2 / G1 / G2</small></span>
        </a>
        <nav class="main-nav">
          {nav.map(([href, label]) => (
            <a href={href} class={active === href ? 'active' : ''}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <strong>SO Davoli Ripasso</strong>
        <p>
          Materiale didattico non ufficiale. Verifica sempre sul testo completo.
          Fonti: <a href="https://www.cs.unibo.it/~renzo/so/compiti-so.shtml">archivio ufficiale Davoli</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
